# ==============================================================================
# Personal AI Assistant - Environment Configuration
# ==============================================================================

# Telegram Bot API Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Google Gemini API Key from Google AI Studio
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Whitelist of allowed Telegram User IDs (comma-separated or single ID)
# e.g., "12345678,87654321"
ALLOWED_TELEGRAM_USER_IDS=123456789,987654321

# Gemini model identifier (Defaults to gemini-3.8-flash for multimodal and web tasks)
GEMINI_MODEL=gemini-3.8-flash

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Rate Limiting (LLM calls per minute per user)
RATE_LIMIT_CALLS_PER_MINUTE=30
